#!/usr/bin/env bash
set -euo pipefail
[[ "${TEMPO_BENCHMARK_METHOD:-}" == pinned-server-10-11-client-12-13 ]]
: "${TEMPO_H2LOAD_REAL:?}"
: "${TEMPO_AFFINITY_LOG:?}"
exec /run/current-system/sw/bin/taskset -c 12,13 bash -c '
  set -euo pipefail
  if [[ "$1" == --version ]]; then exec "$TEMPO_H2LOAD_REAL" "$@"; fi
  "$TEMPO_H2LOAD_REAL" "$@" &
  pid=$!
  trap '\''kill "$pid" 2>/dev/null || :; wait "$pid" 2>/dev/null || :'\'' EXIT
  exe=""
  for attempt in {1..50}; do
    exe=$(readlink -f "/proc/$pid/exe" 2>/dev/null) || :
    [[ "$exe" == "$TEMPO_H2LOAD_REAL" ]] && break
    kill -0 "$pid" 2>/dev/null || exit 1
    sleep 0.01
  done
  [[ "$exe" == "$TEMPO_H2LOAD_REAL" ]] || exit 1
  masks=""
  for status in /proc/"$pid"/task/*/status; do
    [[ -r "$status" ]] || exit 1
    tid=${status%/status}
    tid=${tid##*/}
    mask=$(awk '\''/^Cpus_allowed_list:/ {print $2}'\'' "$status")
    [[ "$mask" == 12-13 ]] || exit 1
    masks+="${masks:+,}$tid:$mask"
  done
  [[ ",$masks," == *,"$pid":12-13,* ]] || exit 1
  printf "%s\t%s\t%s\t%s\t%s\n" "$(date -u +%Y-%m-%dT%H:%M:%S.%NZ)" "$pid" "$exe" "$masks" "$*" >> "$TEMPO_AFFINITY_LOG"
  wait "$pid"
  trap - EXIT
' h2load "$@"
