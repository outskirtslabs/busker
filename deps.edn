{:paths   ["src/main/clojure" "target/classes"]
 :deps    {io.github.IGJoshua/coffi                  {:git/sha "03d74aedecfc7b38238f1cf8b676c1f7a00e1788"}
           com.taoensso/trove                        {:mvn/version "1.1.0"}
           org.ring-clojure/ring-core-protocols      {:mvn/version "1.15.0-beta2"}
           org.ring-clojure/ring-websocket-protocols {:mvn/version "1.15.0-beta2"}}
 :aliases {:kaocha {:extra-paths []
                    :extra-deps  {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
                    :main-opts   ["-m" "kaocha.runner"]}
           :build  {:deps       {io.github.clojure/tools.build {:git/tag "v0.10.10"
                                                                :git/sha "deedd62"}
                                 slipset/deps-deploy           {:mvn/version "0.2.2"}}
                    :ns-default build}
           :test   {:extra-paths ["src/test/clojure"]
                    :extra-deps  {}}
           :dev    {:extra-paths ["dev"]
                    :jvm-opts
                    ["--enable-native-access=ALL-UNNAMED"
                     "-Duser.timezone=UTC"
                     "-XX:+UseZGC"
                     "-XX:+EnableDynamicAgentLoading"
                     "-Djdk.attach.allowAttachSelf"]
                    :extra-deps  {dev.weavejester/hashp                    {:mvn/version "0.4.0"}
                                  criterium/criterium                      {:mvn/version "0.4.6"}
                                  virgil/virgil                            {:mvn/version "0.5.0"}
                                  babashka/process                         {:mvn/version "0.6.23"}
                                  org.babashka/http-client                 {:mvn/version "0.4.22"}
                                  com.cnuernber/charred                    {:mvn/version "1.034"}
                                  org.clojure/clojure                      {:mvn/version "1.12.1"}
                                  io.github.tonsky/clj-reload              {:mvn/version "1.0.0"}
                                  org.clojure/tools.deps                   {:mvn/version "0.24.1523"}
                                  com.clojure-goes-fast/clj-async-profiler {:mvn/version "1.6.2"}
                                  ol.http-clj/macos-aarch64                {:local/root "shim/macos-aarch64"}
                                  ol.http-clj/linux-x86-64                 {:local/root "shim/linux-x86-64"}}}
           :bench  {:extra-paths ["src/test/clojure" "src/test/resources"]
                    :extra-deps  {http-kit/http-kit              {:mvn/version "2.8.0"}
                                  info.sunng/ring-jetty9-adapter {:mvn/version "0.39.0"}
                                  ;; info.sunng/ring-jetty9-adapter-http2 {:mvn/version "0.39.0"}
                                  ;; info.sunng/ring-jetty9-adapter-http3 {:mvn/version "0.39.0"}
                                  ring/ring-jetty-adapter        {:mvn/version "1.15.3"}}}
           :mcp/clojure
           {:deps    {org.slf4j/slf4j-nop     {:mvn/version "2.0.17"}
                      com.bhauman/clojure-mcp {:git/url "https://github.com/bhauman/clojure-mcp.git"
                                               :git/tag "v0.1.10-alpha"
                                               :git/sha "8bd96c3b3d21706cd969e8b9fc5ac9975bc6c6e4"}}
            :exec-fn clojure-mcp.main/start-mcp-server}
           :neil   {:project {:url "https://github.com/outskirtslabs/http"
                              :scm [:scm
                                    [:url "https://github.com/outskirtslabs/http"]
                                    [:connection "scm:git:https://github.com/outskirtslabs/http.git"]
                                    [:developerConnection "scm:git:ssh:git@github.com:outskirtslabs/http.git"]]}}}}
