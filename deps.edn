{:paths   ["src/main/clojure" "target/classes"]
 :deps    {;; busker tries to minimize dependencies
           org.suskalo/coffi             {:git/url    "https://github.com/Ramblurr/coffi.git"
                                          :git/branch "feat/update-tools-build"
                                          :git/sha    "9b05e268b915b1992bfd4175cb7c8c7c45d8973a"}
           ;; busker requires trove for its light pluggiable logging facade
           com.taoensso/trove            {:mvn/version "1.1.0"}
           ;; busker requires clave, an ACME client, to power its auto https features
           io.github.outskirtslabs/clave {:git/sha "04f7bf854bcbe379df14e3f9d7221af9d0c030d6"}
           ;; busker requires charred because implementing ACME requires speaking JSON, and clave makes it a peer dep
           com.cnuernber/charred         {:mvn/version "1.037"}}
 :aliases {:kaocha {:extra-paths []
                    :extra-deps  {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
                    :main-opts   ["-m" "kaocha.runner"]}
           :build  {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                                 org.clojure/tools.deps.cli    {:mvn/version "0.15.131"}}
                    :ns-default build}
           :deploy {:extra-deps {slipset/deps-deploy {:mvn/version "0.2.5"}}}
           :test   {:extra-paths ["src/test/clojure"]
                    :extra-deps {ring/ring-core {:mvn/version "1.15.3"}}
                    :jvm-opts ["-Xmx8g"]}
           :dev    {:extra-paths ["dev"]
                    :jvm-opts
                    ["-Xmx8g"
                     "--enable-native-access=ALL-UNNAMED"
                     "-Duser.timezone=UTC"
                     "-XX:+UseZGC"
                     "-XX:+EnableDynamicAgentLoading"
                     "-Djdk.attach.allowAttachSelf"]
                    :extra-deps  {dev.weavejester/hashp                    {:mvn/version "0.5.1"}
                                  org.slf4j/slf4j-nop                      {:mvn/version "2.0.17"}
                                  criterium/criterium                      {:mvn/version "0.4.6"}
                                  babashka/process                         {:mvn/version "0.6.23"}
                                  org.babashka/http-client                 {:mvn/version "0.4.23"}
                                  org.clojure/clojure                      {:mvn/version "1.12.4"}
                                  io.github.tonsky/clj-reload              {:mvn/version "1.0.0"}
                                  org.clojure/tools.deps                   {:mvn/version "0.26.1553"}
                                  org.ring-clojure/ring-core-protocols     {:mvn/version "1.15.3"}
                                  com.clojure-goes-fast/clj-async-profiler {:mvn/version "1.6.2"}
                                  com.outskirtslabs.busker/macos-aarch64   {:mvn/version "0.0.4"}
                                  com.outskirtslabs.busker/linux-x86-64    {:local/root "shim/linux-x86-64"}}}
           :bench  {:extra-paths ["bench"]
                    :main-opts   ["-m" "capra.benchmark"]

                    :jvm-opts ["-Xmx8g" "--enable-native-access=ALL-UNNAMED"]
                    :extra-deps  {org.slf4j/slf4j-nop                      {:mvn/version "2.0.17"}
                                  aleph/aleph                       {:mvn/version "0.9.9"}
                                  com.s-exp/hirundo                 {:mvn/version "1.0.0-alpha214"}
                                  dev.weavejester/capra             {:mvn/version "0.1.2"}
                                  luminus/ring-undertow-adapter     {:mvn/version "1.5.2"}
                                  org.clojure/data.json             {:mvn/version "2.5.1"}
                                  org.clojars.jj/ring-http-exchange {:mvn/version "1.4.8"}
                                  http-kit/http-kit                 {:mvn/version "2.9.0-beta4"}
                                  com.outskirtslabs.busker/linux-aarch64 {:local/root "shim/linux-aarch64"}
                                  com.outskirtslabs.busker/linux-x86-64  {:local/root "shim/linux-x86-64"}
                                  com.outskirtslabs.busker/macos-aarch64 {:local/root "shim/macos-aarch64"}
                                  com.outskirtslabs.busker/macos-x86-64  {:local/root "shim/macos-x86-64"}
                                  ring/ring-jetty-adapter           {:mvn/version "1.15.3"}}}

           :neil {:project {:name        com.outskirtslabs/busker
                            :description "Busker is your Clojure web server that plays live on the open web"
                            :license     {:id "EUPL-1.2"}
                            :platforms   [:clj :linux :macos]
                            :created     "2025-10-10"
                            :status      :experimental
                            :version     "0.0.4"
                            :url         "https://github.com/outskirtslabs/busker"
                            :scm         [:scm
                                          [:url "https://github.com/outskirtslabs/busker"]
                                          [:connection "scm:git:https://github.com/outskirtslabs/busker.git"]
                                          [:developerConnection "scm:git:ssh:git@github.com:outskirtslabs/busker.git"]]}}}}
