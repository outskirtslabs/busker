
{:min-bb-version "0.8.156"
 :deps           {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
 :paths          ["scripts"]
 :tasks          {:requires           ([babashka.fs :as fs]
                                       [clojure.string :as str]
                                       [babashka.tasks :refer [shell]])
                  compile-shim        {:doc "Compile C shim library" :task (shell {:dir "shim"} "zig build -Doptimize=Debug")}
                  prep                {:doc "Prepare the clojure deps" :task (clojure "-Xdeps prep :aliases '[:dev :test]'")}
                  compile             {:doc "Compile all the things" :depends [compile-shim prep]}
                  test                (apply clojure "-M:dev:test:kaocha" *command-line-args*)
                  test.large-payloads {:doc  "Run large payload tests with restricted memory (2GB heap)"
                                       :task (clojure "-J-Xmx2g" "-J-Xms2g" "-M:dev:test:kaocha" "--no-capture-output" "--focus" "ol.h2o.large-payload-test")}
                  deps-tree           (clojure "-X:deps tree :aliases '[:dev]'")
                  dev                 {:doc "Start a local development server" :task (apply clojure "-M:dev:repl/dev" *command-line-args*)}
                  lint.copy-configs   {:doc  "Copy clj-kondo config files from deps in the project"
                                       :task (let [cp (-> (shell {:out :string} "clojure -Spath -M:test:dev") :out str/trim)]
                                               (shell (str "clj-kondo --lint " cp " --dependencies --copy-configs --skip-lint")))}
                  lint                {:doc  "Run the clj-kondo linter on the clojure code"
                                       :task (shell (str "clj-kondo" " --fail-level error"
                                                         (if (seq *command-line-args*)
                                                           (str " --lint " (first *command-line-args*))
                                                           " --lint src")))}
                  bench               {:doc  "Run the benchmark suite (wraps `clojure -M:dev:bench -m ol.h2o.benchmark`)"
                                       :task (apply clojure "-M:dev:bench" "-m" "ol.h2o.benchmark" *command-line-args*)}
                  jar                 {:depends          [clean compile]
                                       :override-builtin true
                                       :doc              "Build jars"
                                       :task             (let [arch-dirs ["shim/linux-x86-64" "shim/macos-x86-64" "shim/macos-aarch64"]]
                                                           (doseq [dir arch-dirs]
                                                             (println (str "Building jar for " dir))
                                                             (shell {:dir dir} "clj -T:build jar"))
                                                           #_(shell "clojure -T:build jar"))}
                  clean               {:override-builtin true
                                       :doc              "Clean build artifacts"
                                       :task
                                       (do
                                         (shell {:dir "."} "rm -rf zig-out zig-cache")
                                         (shell {:dir "."} "rm -rf shim/linux-x86-64/resources shim/macos-x86-64/resources shim/macos-aarch64/resources")
                                         (shell {:dir "."} "rm -rf shim/linux-x86-64/target shim/macos-x86-64/target shim/macos-aarch64/target")
                                         (shell {:dir "."} "clj -T:build clean"))}
                  publish             {:doc     "Publish the clojure sdk libs to clojars"
                                       :depends [jar]
                                       :task    (clojure "-T:build deploy")}
                  pom                 {:doc "Generate the pom.xml from clj" :task (clojure "-Xdeps mvn-pom :aliases '[:dev :test]'")}
                  ci                  {:depends [compile test test.large-payloads jar]}}}
