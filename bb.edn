{:min-bb-version "0.8.156"
 :paths          ["src/bb"]
 :deps           {borkdude/rewrite-edn   {:mvn/version "0.4.9"}
                  lambdaisland/kaocha    {:mvn/version "1.91.1392"}
                  outskirtslabs/bb-tasks {:git/url "https://github.com/outskirtslabs/bb-tasks"
                                          :git/sha "9dbc6d77384b51ffde69007e98a0420b3cf6a0a7"}}
 :pods           {clj-kondo/clj-kondo {:version "2026.01.19"}}
 :tasks          {:requires ([babashka.fs :as fs]
                             [tasks.build  :as build]
                             [tasks.hcloud :as hcloud]
                             [tasks.pebble :as pebble]
                             [tasks.smoke  :as smoke]
                             [clojure.string :as str]
                             [babashka.tasks :refer [shell]]
                             [ol.bb-tasks.gen-docs :as gen-docs]
                             [ol.bb-tasks.publish-clojars :as publish-clojars])
                  :init     (do (def paths ["src" "dev"]))

                  build:shim
                  {:doc  "Compile C shim library"
                   :task (shell {:dir "shim"} "zig build -Doptimize=Debug")}

                  prep
                  {:doc  "Prepare the clojure deps"
                   :task (clojure "-X:deps prep :aliases '[:dev :test]'")}

                  jar:native
                  {:depends [prep build:shim]
                   :doc     "Build native dep jars"
                   :task    (doseq [dir build/lib-dirs]
                              (println (str "Building jar for " dir))
                              (shell {:dir dir} "clj -T:build jar"))}

                  build
                  {:doc     "Compile all the things"
                   :depends [clean jar:native]}

                  jar:lib
                  {:depends [build]
                   :doc     "Build the jar for busker"
                   :task    (shell "clojure -T:build jar")}

                  jar:all
                  {:depends [build jar:lib]
                   :doc     "Build the jars"}

                  clean
                  {:override-builtin true
                   :doc              "Clean build artifacts"
                   :task
                   (do
                     (shell {:dir "shim"} "rm -rf zig-out zig-cache")
                     (shell {:dir "shim"} "rm -rf linux-x86-64/resources linux-aarch64/resources macos-x86-64/resources macos-aarch64/resources")
                     (shell {:dir "shim"} "rm -rf linux-x86-64/target linux-aarch64/target macos-x86-64/target macos-aarch64/target")
                     (shell {:dir "."} "clj -T:build clean"))}

                  dist-clean
                  {:override-builtin true
                   :doc              "Clean everything"
                   :depends          [clean]
                   :task             (shell {:dir "shim"} "rm -rf .zig-cache .zig-cache-global")}

                  publish
                  {:doc     "Publish the clojure libs to clojars"
                   :depends [jar:all]
                   :task    (publish-clojars/publish!)}

                  set-version
                  {:doc  "Set the version in all libs"
                   :task (doseq [dir build/lib-dirs]
                           (build/lib-set-version! dir (first *command-line-args*)))}

                  bump-version
                  {:doc  "Bump the version component in all libs. First argument must be one of: major, minor, patch"
                   :task (doseq [dir build/lib-dirs]
                           (let [component (first *command-line-args*)]
                             (build/lib-bump! dir component)))}

                  publish:native
                  {:doc     "Publish native jars to clojars"
                   :depends [prep build:shim]
                   :task    (build/publish-libs! build/lib-dirs)}

                  publish:all
                  {:doc     "Publish the clojure libs to clojars"
                   :depends [jar:all]
                   :task    (doseq [dir (conj build/lib-dirs ".")]
                              (build/lib-publish! dir))}

                  dev
                  {:doc  "Start a local development repl"
                   :task (apply clojure "-M:dev:repl/dev" *command-line-args*)}

                  pebble:start
                  {:doc  "Start local Pebble ACME fixture in the background"
                   :task (pebble/start!)}

                  pebble:stop
                  {:doc  "Stop local Pebble ACME fixture"
                   :task (pebble/stop!)}

                  pebble:status
                  {:doc  "Show local Pebble ACME fixture status"
                   :task (pebble/status!)}

                  pebble:logs
                  {:doc  "Tail local Pebble ACME fixture logs"
                   :task (pebble/logs!)}

                  smoke:managed
                  {:doc  "Run smoke with local Pebble managed TLS fixture"
                   :task (apply smoke/smoke-managed! *command-line-args*)}

                  test
                  {:doc  "Run tests"
                   :depends [build:shim]
                   :task (apply clojure "-M:dev:test:kaocha" *command-line-args*)}

                  test:large-payloads
                  {:doc  "Run large payload tests"
                   :depends [build:shim]
                   :task (clojure "-J-Xmx2g" "-J-Xms2g" "-M:dev:test:kaocha" "--no-capture-output" "--focus" "ol.busker.large-payload-test")}

                  test:all
                  {:doc     "Run all the tests"
                   :depends [test test:large-payloads]}

                  fmt
                  {:doc  "Format code with cljfmt"
                   :task (apply shell "cljfmt --quiet -v fix" (if (seq *command-line-args*) *command-line-args* paths))}

                  fmt:check
                  {:doc  "Check code formatting without making changes"
                   :task (apply shell "cljfmt check " paths)}

                  lint:copy-configs
                  {:doc  "Copy clj-kondo config files from deps in the project"
                   :task (let [cp (-> (shell {:out :string} "clojure -Spath -M:test:dev") :out str/trim)]
                           (shell (str "clj-kondo --lint " cp " --dependencies --copy-configs --skip-lint")))}

                  lint
                  {:doc  "Run the clj-kondo linter on the clojure code"
                   :task (shell (str "clj-kondo" " --fail-level error"
                                     (if (seq *command-line-args*)
                                       (str " --lint " (first *command-line-args*))
                                       " --lint src")))}

                  hcloud
                  {:doc  "Manage the Hetzner Cloud benchmark server"
                   :task (apply hcloud/run *command-line-args*)}

                  bench
                  {:doc  "Run the Ring adapter benchmark suite"
                   :task (apply clojure "-M:bench" *command-line-args*)}

                  bench:busker
                  {:doc  "Run the benchmark suite with Busker only"
                   :task (apply clojure "-M:bench" "--adapter" "busker" *command-line-args*)}

                  bench:smoke
                  {:doc "Run the short local benchmark smoke profile"
                   :task (apply clojure "-M:bench" "--smoke" *command-line-args*)}

                  bench:graph
                  {:doc "Render benchmark JSON as SVG throughput graphs"
                   :task (apply shell "python3" "bench/graph.py" *command-line-args*)}

                  bench:check-graphs
                  {:doc "Verify benchmark graph output is reproducible"
                   :task (shell "bash" "-c"
                                (str "dir=$(mktemp -d); "
                                     "python3 bench/graph.py bench/fixtures/sample-results.json $dir/first; "
                                     "python3 bench/graph.py bench/fixtures/sample-results.json $dir/second; "
                                     "diff -r $dir/first $dir/second; rm -rf $dir"))}

                  deps-tree
                  {:doc  "Show dependency tree"
                   :task (clojure "-X:deps tree :aliases '[:dev]'")}

                  lockfile
                  {:doc "Update the clojure nix lockfile"
                   :task (shell "nix run .#locker")}

                  qa
                  {:doc     "Run full quality assurance: format, lint, and test"
                   :depends [build lint test:all test]}

                  gen-docs
                  {:doc  "Generate all Antora documentation"
                   :task (gen-docs/generate! {:external-api-index-paths ["../clave/doc/api-index.edn"]})}

                  ci
                  {:doc     "Ran by the CI"
                   :depends [build test:all fmt:check lint jar:all lockfile]}}}
